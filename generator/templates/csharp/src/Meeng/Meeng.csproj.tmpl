<Project Sdk="Microsoft.NET.Sdk">

  <!--
    net8.0 and net10.0 are the LTS releases: System.Text.Json, HMACSHA256 and
    IAsyncEnumerable are in the box there, so the package depends on nothing.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Meeng</RootNamespace>
    <AssemblyName>Meeng</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- Not packable until the names are confirmed. -->
    <IsPackable>false</IsPackable>
    <PackageId>MeengDev.Sdk</PackageId>
    <Version>{{.Version}}</Version>
    <Authors>meeng</Authors>
    <Company>meeng</Company>
    <Description>Meeng.dev SDK for .NET: emails, domains, contacts, contact books, campaigns, analytics and webhooks.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://meeng.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/meeng-dev/sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>meeng;email;smtp;transactional;webhooks</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
