[package]
name = "meeng-sdk"
version = "{{.Version}}"
edition = "2021"
rust-version = "1.88"
description = "meeng's SDK for Rust: products, customers, checkouts, payments, subscriptions and webhooks."
license = "MIT"
homepage = "https://meeng.dev"
repository = "https://github.com/meeng-dev/sdk"
documentation = "https://docs.rs/meeng-sdk"
readme = "README.md"
keywords = ["meeng", "payments", "pix", "api", "webhooks"]
categories = ["api-bindings", "web-programming::http-client"]

[lib]
# The crate is meeng-sdk; the code says `use meeng::…`.
name = "meeng"

[dependencies]
base64 = "0.23"
hmac = "0.13"
serde = { version = "1.0.200", features = ["derive"] }
serde_json = "1.0.100"
sha2 = "0.11"
ureq = { version = "3", default-features = false, features = ["rustls"] }
