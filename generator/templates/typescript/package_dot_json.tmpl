{
  "name": "@meeng-dev/sdk",
  "version": "{{.Version}}",
  "description": "SDK do Meeng.dev para TypeScript e JavaScript: e-mails, domínios, contatos, listas de contatos, campanhas, análises e webhooks.",
  "license": "MIT",
  "homepage": "https://meeng.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meeng-dev/sdk.git",
    "directory": "typescript"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc --ignoreConfig --noEmit --module nodenext --moduleResolution nodenext --target es2022 --lib es2022,dom --types node --strict --noUncheckedIndexedAccess --allowImportingTsExtensions --skipLibCheck test/*.test.ts examples/*.ts",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "typescript": "^7.0.2"
  }
}
