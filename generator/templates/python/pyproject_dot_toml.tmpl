[build-system]
requires = ["hatchling>=1.33"]
build-backend = "hatchling.build"

[project]
name = "meeng-sdk"
version = "{{.Version}}"
description = "SDK do Meeng.dev para Python: e-mails, domínios, contatos, listas de contatos, campanhas, análises e webhooks."
readme = "README.md"
license = "MIT"
requires-python = ">=3.11"
dependencies = []
classifiers = [
    "Programming Language :: Python :: 3",
    "Typing :: Typed",
]

[project.urls]
Homepage = "https://meeng.dev"
Repository = "https://github.com/meeng-dev/sdk"

[tool.hatch.build.targets.wheel]
packages = ["src/meeng"]
